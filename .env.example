#--------------------------------------------------------------------
# CodeIgniter 4 environment template
# Copy to .env and fill in the REPLACE_ME values.
# Never commit .env — only this file.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (Layerbase MariaDB)
#--------------------------------------------------------------------
database.default.hostname = REPLACE_ME
database.default.database = REPLACE_ME
database.default.username = REPLACE_ME
database.default.password = REPLACE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.pConnect = true

#--------------------------------------------------------------------
# EMBEDDING SERVICE (embedding-service/, see README)
# Keep the trailing slash.
#--------------------------------------------------------------------
embedding.baseURL = 'http://localhost:8001/'
# embed:auto (cron) embeds waiting showcases once this many are waiting,
# or once the oldest has waited this many minutes, whichever comes first.
# embedding.autoBatchSize = 20
# embedding.autoMaxWaitMinutes = 15

#--------------------------------------------------------------------
# MATCHER (matcher/, see README)
# Keep the trailing slash.
#--------------------------------------------------------------------
matcher.baseURL = 'http://localhost:8002/'

#--------------------------------------------------------------------
# ENCRYPTION
# Generate a fresh key after copying: `php spark key:generate`
#--------------------------------------------------------------------
encryption.key =
