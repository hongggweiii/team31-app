# Settings for the two engine services, and for handover/testing/check.py.
# Copy to engine.env next to the embedding-service/ and matcher/ folders,
# fill in, and keep it out of git (it holds the database password).
#
# Loaded by:
#   uvicorn app:app --env-file ../engine.env ...        (the services; see deployment-and-operations.md)
#   python check.py --env-file ../../engine.env ...     (the checks, from handover/testing/)
#   docker run --env-file engine.env ...                (if you containerise the services)
# Values may contain spaces and special characters. Quote them if they
# contain " #" or start with a quote (not for Docker, which takes values
# literally). Don't load this file with a shell `export`: names with dots are refused.

# ---- matcher (port 8002) --------------------------------------------------
# The database holding your profiles, the sf_* taxonomy and the embeddings
# (handover/sql). The matcher reads it and writes only gig_embeddings.
database.default.hostname=localhost
database.default.port=3306
database.default.username=senseigigz_matcher
database.default.password=REPLACE_ME
database.default.database=senseigigz

# Where embedding-service listens, as the matcher reaches it. Keep the trailing slash.
embedding.baseURL=http://localhost:8001/

# Optional: a label for this server, reported in every match's meta.machine
# (and saved by the run recording, integration-guide.md G8). Unset: the CPU name.
#MATCHER_MACHINE=aws c7i.xlarge

# ---- embedding-service (port 8001) ------------------------------------------
# cpu, cuda or mps. Leave unset to let it choose (GPU when available).
# GET /health reports the device in use.
#EMBED_DEVICE=cpu

# ---- check.py only ------------------------------------------------------------
# check.py reads the database.default.* and embedding.baseURL values above.
# Add these when they differ from its defaults:
#MATCHER_URL=http://localhost:8002
#CHECK_GIG_ID=
# A different database user for the checks (read-only is enough, except for
# `lifecycle --auto`): set DB_USER / DB_PASSWORD as environment variables, which win over this file.
