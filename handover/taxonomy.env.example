# Settings for the OPTIONAL taxonomy-service (port 8003): AI tag suggestion and
# the review of new taxonomy terms (integration-guide.md, G9-G11).
# Copy to taxonomy.env next to the taxonomy-service/ folder (beside engine.env),
# fill in, and keep it out of git (it holds the database password and the OpenAI key).
#
# Kept apart from engine.env because the setting names are the same as the
# matcher's (database.default.*), but this service needs a different database
# user with more rights (deployment-and-operations.md, "Configure"), and the
# matcher has no use for the OpenAI key.
#
# Loaded by:
#   uvicorn app:app --env-file ../taxonomy.env ...   (always pass it: without it the
#                                                     service looks for ../.env instead)
# Same quoting rules as engine.env.example.

# ---- database ----------------------------------------------------------------
# The database holding the sf_* taxonomy, your gigs / showcases and their tags.
database.default.hostname=localhost
database.default.port=3306
database.default.username=senseigigz_taxonomy
database.default.password=REPLACE_ME
database.default.database=senseigigz

# ---- OpenAI ------------------------------------------------------------------
# Needed for /suggest and the synonym check of new terms. Without it /suggest
# answers 503 and users pick tags by hand.
OPENAI_API_KEY=REPLACE_ME
# The model, and how long to wait for it (seconds) before answering 503.
# Keep the timeout under your app's own timeout for this service (we use 25 s).
#taxonomy.openaiModel=gpt-4o-mini
#taxonomy.openaiTimeout=20

# ---- behaviour ---------------------------------------------------------------
# How long the taxonomy is kept in memory before it is re-read (seconds).
# POST /refresh re-reads it at once.
#taxonomy.cacheSeconds=86400
# How alike (0-100) two names must be to count as a close spelling match.
#taxonomy.fuzzySimilarityPct=85

# ---- security ----------------------------------------------------------------
# A shared secret. When set, every request must send it as the X-Service-Token
# header, or gets 401. Set it, and give your app the same value.
taxonomy.serviceToken=REPLACE_ME
